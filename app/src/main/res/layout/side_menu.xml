<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sideMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffffff">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/partyMembersLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#D9002B66"
                android:padding="6dp">

                <TextView
                    android:id="@+id/partyMemberHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:paddingBottom="4dp"/>

                <LinearLayout
                    android:id="@+id/partyMemberList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <Button
                android:id="@+id/jumpToMarker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="12dp"
                android:text="@string/jump_to_marker"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:cornerRadius="0dp"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/openSwimLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="12dp"
                android:text="@string/swim_logs"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:cornerRadius="0dp"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/openSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                app:cornerRadius="0dp"
                android:padding="12dp"
                android:layout_margin="0dp"
                android:text="@string/open_settings"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/createParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                app:cornerRadius="0dp"
                android:padding="12dp"
                android:layout_margin="0dp"
                android:text="@string/create_party"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/joinParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                app:cornerRadius="0dp"
                android:padding="12dp"
                android:layout_margin="0dp"
                android:text="@string/join_party"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/inviteParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                app:cornerRadius="0dp"
                android:padding="12dp"
                android:layout_margin="0dp"
                android:text="@string/invite_party"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/leaveParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                app:backgroundTint="@color/black"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp"
                app:cornerRadius="0dp"
                android:padding="12dp"
                android:layout_margin="0dp"
                android:text="@string/leave_party"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"/>

            <!-- 開発用 / デバッグ機能セクション -->
            <LinearLayout
                android:id="@+id/debugMenuLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#22FF8800"
                android:padding="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_header"
                    android:textColor="#CC6600"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnDebugToggleSwimming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FF444444"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_toggle_swim_off"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnDebugStartSwim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FF1B5E20"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_start_swim"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnDebugFinishSwim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FFB71C1C"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_finish_swim"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnDebugLocationOffset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FF007799"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_location_offset"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="#66CC6600" />

                <Button
                    android:id="@+id/btnDebugTestEEW"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FFD84315"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_test_eew"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnDebugTestEEWStrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FFB71C1C"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_test_eew_strong"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnDebugTestQuake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    app:backgroundTint="#FFF57C00"
                    app:strokeColor="#CC6600"
                    app:strokeWidth="1dp"
                    app:cornerRadius="0dp"
                    android:padding="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="12sp"
                    android:text="@string/debug_test_quake"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</LinearLayout>