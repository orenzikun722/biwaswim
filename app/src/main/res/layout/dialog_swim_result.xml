<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A1128"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ダイアログヘッダー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/swim_finished_dialog_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseResult"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 画像生成中プログレス -->
        <LinearLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#00E5FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/generating_card"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 生成されたカード画像プレビュー -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <ImageView
                android:id="@+id/cardImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/share_swim_record"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <!-- アクションボタンエリア -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- 共有 / SNSで自慢ボタン -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🚀 SNSで自慢・シェア"
                android:textColor="#0A1128"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#00E5FF"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- 画像保存ボタン -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveGallery"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="💾 画像保存"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="#1E293B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp" />

                <!-- 地図で軌跡を見るボタン -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewOnMap"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="🗺️ 地図で見る"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="#1E293B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
